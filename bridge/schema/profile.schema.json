{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ugs-bridge/profile/1",
  "title": "Machine profile",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "format": {
      "const": "ugs-bridge-profile/1"
    },
    "name": {
      "type": "string"
    },
    "controller": {
      "type": "string"
    },
    "envelope_mm": {
      "type": "object",
      "properties": {
        "min": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "max": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [
        "min",
        "max",
        "verified"
      ],
      "additionalProperties": true
    },
    "homing_corner": {
      "type": "string"
    },
    "safe_z_machine": {
      "type": "number"
    },
    "tool_change_park": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "bitsetter": {
      "type": "object",
      "properties": {
        "xy": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "start_z_machine": {
          "type": "number"
        },
        "max_travel": {
          "type": "number"
        },
        "fast_feed": {
          "type": "number"
        },
        "slow_feed": {
          "type": "number"
        },
        "retract": {
          "type": "number"
        },
        "repeat_tolerance": {
          "type": "number"
        },
        "pin": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "bitzero": {
      "type": "object",
      "properties": {
        "plate_thickness": {
          "type": [
            "number",
            "null"
          ]
        },
        "plate_thickness_verified": {
          "type": "boolean"
        },
        "xy_offset": {
          "type": [
            "number",
            "null"
          ]
        },
        "max_travel": {
          "type": "number"
        },
        "fast_feed": {
          "type": "number"
        },
        "slow_feed": {
          "type": "number"
        },
        "retract": {
          "type": "number"
        },
        "pin": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "spindle": {
      "type": "object",
      "properties": {
        "control": {
          "type": "string",
          "enum": [
            "bitrunner",
            "pwm",
            "manual"
          ],
          "description": "bitrunner: a relay switches the router on/off, its dial sets the speed (S only has to be high enough to trigger it); pwm: S sets the speed (VFD/PWM spindle); manual: the operator switches it."
        },
        "spin_up_s": {
          "type": "number"
        },
        "spin_down_s": {
          "type": "number",
          "minimum": 0,
          "description": "seconds the router coasts after M5; the tool-change prompt waits it out (ledger D2a)"
        },
        "s_on_verified": {
          "type": "number",
          "minimum": 0,
          "description": "bitrunner: an S value seen to switch the router on (ledger C7)"
        },
        "s_off_verified": {
          "type": "number",
          "minimum": 0,
          "description": "bitrunner: an S value seen NOT to switch the router on; S at or below it is an error"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "connect_resets_controller": {
      "type": "boolean"
    },
    "expected_settings": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "rapid_mm_min": {
      "type": [
        "number",
        "null"
      ],
      "description": "max rapid rate for time estimates when a file has no (Rapids:) header"
    },
    "planner_blocks": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "GRBL planner blocks, as $I reports in [OPT:<codes>,<blocks>,<rx bytes>]; the live $I value wins"
    },
    "rx_buffer_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 16,
      "description": "GRBL serial RX buffer bytes, as $I reports in [OPT:<codes>,<blocks>,<rx bytes>]; the live $I value wins"
    },
    "motion": {
      "type": [
        "object",
        "null"
      ],
      "description": "GRBL motion limits for the planner time estimate ($110-$112 mm/min, $120-$122 mm/s2, $11, $12); the live $$ wins",
      "properties": {
        "max_rate_mm_min": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 3, "maxItems": 3},
        "accel_mm_s2": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 3, "maxItems": 3},
        "junction_deviation_mm": {"type": ["number", "null"], "minimum": 0},
        "arc_tolerance_mm": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "source": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "spoilboard_z_machine": {
      "type": [
        "number",
        "null"
      ],
      "description": "machine Z of the spoilboard surface with the reference tool; null until measured"
    }
  },
  "required": [
    "format",
    "name",
    "envelope_mm",
    "safe_z_machine",
    "bitsetter",
    "bitzero",
    "spindle"
  ]
}
